# ============================================================
# Momentum – Environment Variable Reference
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ============================================================

# ── Application ──────────────────────────────────────────────
# A long random string used to sign sessions and tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Application environment: development | production | testing
FLASK_ENV=development

# Set to 1 to enable Flask debug mode (development only)
FLASK_DEBUG=1

# ── Database ─────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=your_database_url

# PostgreSQL example (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/momentum_db

# ── Mail ─────────────────────────────────────────────────────
MAIL_SERVER=your_mail_server
MAIL_PORT=mail_port
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password

# ── Security ─────────────────────────────────────────────────
# Salt for password-reset tokens (separate from SECRET_KEY).
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
SECURITY_PASSWORD_SALT=change-me-to-another-random-string

# Session cookie settings (use Secure=true in production with HTTPS)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
